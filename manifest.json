{
  "manifest_version": 3,
  "name": "ページ書き込みツール",
  "version": "1.0.7",
  "description": "Web ページにマウス/タッチで書き込み。スクロールしても位置がズレず追従し、書き込み込みでページを保存できる。",
  "permissions": ["pageCapture", "downloads", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ページ書き込みツール（クリックでツールバー表示切替）"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
